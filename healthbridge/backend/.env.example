# ============================================================
# HealthBridge API — Environment Variables
# Copy to .env and fill in values. NEVER commit .env to git.
# ============================================================

# Server
NODE_ENV=development
PORT=3001
API_BASE_URL=http://localhost:3001

# PostgreSQL
DATABASE_URL=postgresql://healthbridge:password@localhost:5432/healthbridge_db
DB_SSL=false

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_minimum_32_chars
JWT_EXPIRES_IN=7d

# WhatsApp (Meta Cloud API)
META_API_VERSION=v19.0
META_APP_SECRET=your_meta_app_secret_here
WHATSAPP_VERIFY_TOKEN=your_custom_webhook_verify_token_here
# Per-hospital WhatsApp credentials are stored in DB (hospitals table)
# WHATSAPP_ACCESS_TOKEN is fetched per-request or set globally for shared BSP
WHATSAPP_ACCESS_TOKEN=your_whatsapp_system_user_access_token

# AWS S3
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
S3_BUCKET_NAME=healthbridge-reports
S3_SIGNED_URL_EXPIRY_SECONDS=172800

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Queue Alert Settings
QUEUE_ALERT_AHEAD_TOKENS=3
QUEUE_CHECK_INTERVAL_MS=120000

# Bcrypt
BCRYPT_ROUNDS=12

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
WHATSAPP_RATE_LIMIT_PER_PHONE=20
